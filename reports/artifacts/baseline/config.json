{
  "seed": 42,
  "label_mapping": {
    "0": "NORMAL",
    "1": "PNEUMONIA"
  },
  "train_split_csv": "data/splits/train_duplicate_aware.csv",
  "val_split_csv": "data/splits/val_duplicate_aware.csv",
  "image_dir": "data/images",
  "output_dir": "outputs/custom_cnn_baseline",
  "image_size": 224,
  "batch_size": 32,
  "epochs": 25,
  "num_workers": 2,
  "learning_rate": 0.001,
  "weight_decay": 0.0001,
  "dropout": 0.4,
  "optimizer": "AdamW",
  "loss": "CrossEntropyLoss",
  "scheduler": "ReduceLROnPlateau",
  "scheduler_factor": 0.5,
  "scheduler_patience": 2,
  "early_stopping_metric": "val_f1",
  "early_stopping_patience": 5,
  "best_checkpoint_metric": "val_f1",
  "use_class_weights": true
}
